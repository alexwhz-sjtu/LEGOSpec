-# Qwen3.8-27B DFlash2 on one 8-GPU node: four TP=1 capture servers on GPUs 0-3
-# and a DP=4 DFlash2 trainer on GPUs 4-7, all owned by `specforge train`.
-#
-# The split, flow control and Mooncake settings are the ones measured in
-# docs/recipes/qwen3.8-27b-dflash2-disaggregated.md on 8x B300 and 8x H200.
-# The balanced split depends on how fast one GPU captures relative to how fast
-# it trains the draft: on H200 (FP8 target) 5 servers + DP3 was faster than
-# this 4+4 layout (10.65 vs 9.05 samples/s); on B300 4+4 was the best split
-# with the current host receive path (11.5).  Move servers between the two
-# lists below and keep `deployment.trainer.nproc_per_node` equal to the
-# trainer device count.
-model:
-  target_model_path: Qwen/Qwen3.8-27B
-  draft_model_config: configs/qwen3.8-27b-dflash2.json
-  target_backend: sglang
-  trust_remote_code: true
-  embedding_key: model.language_model.embed_tokens.weight
-  torch_dtype: bfloat16
-  mask_token_id: 248070
-  # Capture-server settings exercised by the recipe; flashinfer was not run
-  # for this target.
-  sglang_attention_backend: triton
-  sglang_disable_radix_cache: true
-  # data.max_length + 7 tokens of request headroom for the capture endpoint.
-  sglang_context_length: 8199
-
-data:
-  # Conversations answered by the target itself (on-policy regeneration); see
-  # the recipe document for how the validated corpus was produced.
-  train_data_path: ./cache/dataset/qwen3.8-27b-regen-train.jsonl
-  max_length: 8192
-  chat_template: qwen3.5
-  build_dataset_num_proc: 32
-  # Prefetch depth of the online feature loader.  The in-flight watermarks
-  # below are sized for this value.
-  dataloader_num_workers: 8
-  cache_dir: cache/qwen3.8-27b-dflash2
-
-training:
-  # DFlash2 shares the DFlash capture and data contract; the draft JSON turns
-  # on the local convolutions and the candidate-selector objective.
-  strategy: dflash
-  num_epochs: 1
-  tp_size: 1
-  # 4 ranks x 2 x 4 = 32 samples per optimizer step is the measured
-  # configuration.  When raising accumulation_steps, raise the in-flight
-  # watermarks by the same factor.
-  batch_size: 2
-  accumulation_steps: 4
-  fsdp_sharding: SHARD_GRAD_OP
-  learning_rate: 0.0005
-  lr_scheduler: constant
-  warmup_ratio: 0.05
-  max_grad_norm: 1.0
-  attention_backend: flex_attention
-  num_anchors: 512
-  loss_decay_gamma: 7.0
-  objective_chunk_blocks: 128
-  loss_type: dflash
-  dflash2_selector_loss_alpha: 1.0
-  dflash2_selector_stop_gradient: false
-  save_interval: 500
-  log_interval: 10
-  dist_timeout: 30
-  seed: 42
-  prompt_seed: 42
-
-tracking:
-  report_to: none
-
-runtime:
-  # Each capture server keeps four 4-prompt requests in flight (16 prompts).
-  producer_lease: 4
-  producer_concurrency: 4
-  # Refs stay committed-but-unacknowledged from capture until the optimizer
-  # boundary that consumed them.  With 8 prefetch workers on each of 4 ranks
-  # the leased refs alone reach 64, so 3x the step quantum (96/48) throttles
-  # the producer; 6x (192/96) does not, and 12x adds only backlog latency.
-  in_flight_high_watermark: 192
-  in_flight_low_watermark: 96
-
-run_id: qwen3.8-27b-dflash2-4server-dp4-disaggregated
-output_dir: outputs/qwen3.8-27b-dflash2-4server-dp4-disaggregated
-
-deployment:
