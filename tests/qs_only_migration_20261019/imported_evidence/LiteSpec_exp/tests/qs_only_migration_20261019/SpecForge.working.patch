+class FlashMTPTrainStrategy(DraftTrainStrategy):
+    """FlashMTP block-parallel backbone with a retained serial Markov head."""
+
+    name = "flashmtp"
+    required_features = {"input_ids", "hidden_states", "loss_mask"}
+
+    def __init__(self, flashmtp_model: nn.Module) -> None:
+        self.flashmtp_model = flashmtp_model
+
+    def trainable_module(self) -> nn.Module:
+        return self.flashmtp_model
+
+    def _device(self) -> torch.device:
+        return next(self.flashmtp_model.parameters()).device
+
+    def _captured_hidden_states(
+        self, hidden_states: torch.Tensor
+    ) -> Dict[int, torch.Tensor]:
+        model = self.flashmtp_model
+        while not hasattr(model, "capture_layer_ids"):
+            inner = getattr(model, "module", None)
+            if inner is None:
+                inner = getattr(model, "_fsdp_wrapped_module", None)
+            if inner is None or inner is model:
+                raise AttributeError(
+                    "wrapped FlashMTP model does not expose capture_layer_ids"
+                )
+            model = inner
+        layer_ids = tuple(int(i) for i in model.capture_layer_ids)
+        hidden_size = int(model.draft_model.config.hidden_size)
+        expected_width = len(layer_ids) * hidden_size
+        if hidden_states.ndim != 3 or hidden_states.shape[-1] != expected_width:
+            raise ValueError(
+                "FlashMTP hidden_states must have shape [batch, sequence, "
+                f"{expected_width}] for captured layers {layer_ids}, got "
+                f"{tuple(hidden_states.shape)}"
+            )
+        pieces = hidden_states.split(hidden_size, dim=-1)
+        return dict(zip(layer_ids, pieces))
+
+    def forward_loss(
+        self, batch: TrainBatch, ctx: Optional[StepContext] = None
+    ) -> StepOutput:
+        del ctx
+        self.validate_batch(batch)
+        tensors = batch.tensors
+        device = self._device()
+        hidden_states = tensors["hidden_states"].to(device, non_blocking=True)
+        (
+            loss,
+            accuracy,
+            prefix_accuracy,
+            final_ce_loss,
+            base_ce_loss,
+            tv_loss,
+        ) = self.flashmtp_model(
+            input_ids=tensors["input_ids"].to(device, non_blocking=True),
+            loss_mask=tensors["loss_mask"].to(device, non_blocking=True),
+            hidden_states=self._captured_hidden_states(hidden_states),
+        )
+        return StepOutput(
+            loss=loss,
+            metrics={
+                "accuracy": accuracy.detach(),
+                "prefix_accuracy": prefix_accuracy.detach(),
+                "final_ce_loss": final_ce_loss.detach(),
+                "base_ce_loss": base_ce_loss.detach(),
+                "tv_loss": tv_loss.detach(),
+            },
+        )
+
+    def checkpoint_state_filter(self, state_dict: Dict[str, Any]) -> Dict[str, Any]:
+        return {
+            key.replace("draft_model.", ""): value
+            for key, value in state_dict.items()
+            if "draft_model." in key
+        }
+
+
