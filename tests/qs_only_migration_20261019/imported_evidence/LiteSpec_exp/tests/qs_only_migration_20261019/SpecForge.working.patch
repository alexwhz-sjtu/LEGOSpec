-    consumer_state_dir: outputs/qwen3.8-27b-dflash2-4server-dp4-disaggregated/consumer-state
-    backend: mooncake
-    # Pinned staging buffer of each SpecForge role's Mooncake client.  Neutral
-    # for the current host receive path; the measured runs used 2 GiB.
-    client_buffer_size: 2147483648
-    managed_local:
-      trainer_cuda_visible_devices: ["4", "5", "6", "7"]
-      mooncake:
-        protocol: tcp
-        # One 8192-token sample is ~500 MB of BF16 hidden states.  The 500 ms
-        # schema default expires while several ranks fetch such samples
-        # (Mooncake -707 LEASE_EXPIRED, retried with backoff); 10 s covers it.
-        default_kv_lease_ttl_ms: 10000
