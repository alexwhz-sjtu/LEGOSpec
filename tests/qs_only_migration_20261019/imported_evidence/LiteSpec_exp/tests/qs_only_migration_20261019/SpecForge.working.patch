-  strategy: "dflash"
-  num_epochs: 10
-  max_steps: 10000
-  batch_size: 2
-  accumulation_steps: 4
-  learning_rate: 0.0006
-  warmup_ratio: 0.04
-  max_grad_norm: 1
-  attention_backend: "sdpa"
