{
  "architectures": ["ComposableDraftModel"],
  "schema_version": "composable_v3",
  "block_size": 8,
  "composable_config": {
    "context": {
      "type": "dflare",
      "fusion": "channel_softmax_shared_projection",
      "target_layer_ids": [1, 9, 17, 25, 33]
    },
    "backbone": {
      "type": "layer_stack",
      "layers": [
        {"attention": "gqa", "access": "dense"},
        {"attention": "gqa", "access": "dense"},
        {"attention": "gqa", "access": "dense"},
        {"attention": "gqa", "access": "dense"},
        {"attention": "gqa", "access": "dense"}
      ]
    },
    "proposal": {"type": "rnn", "rank": 256},
    "objective": {
      "type": "weighted_sum",
      "loss_decay_gamma": 4.0,
      "components": [
        {"type": "hard_ce", "weight": 0.1},
        {"type": "l1", "weight": 0.9}
      ]
    },
    "attention_configs": {
      "gqa": {"num_attention_heads": 32, "num_key_value_heads": 8, "head_dim": 128}
    },
    "access_configs": {"dense": {}}
  }
}
