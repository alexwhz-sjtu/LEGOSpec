            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gdn",
          "access": "linear",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gdn",
          "access": "linear",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
