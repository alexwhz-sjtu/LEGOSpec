{
  "architectures": [
    "ComposableDraftModel"
  ],
  "block_size": 8,
  "schema_version": "composable_v3",
  "composable_config": {
    "context": {
      "type": "dflash",
      "target_layer_ids": [
        3,
        11,
        19,
        23,
        27
      ]
    },
    "backbone": {
      "type": "layer_stack",
      "layers": [
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "sliding_window",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        },
        {
          "attention": "gqa",
          "access": "dense",
          "local_operator": {
            "type": "dflash2_conv",
            "kernel_size": 2,
            "group_size": 16
          }
        }
      ]
    },
    "proposal": {
      "type": "residual_selector",
      "rank": 256,
      "top_k": 16,
      "stop_gradient": false,
      "selector_mode": "full_vocab_residual"
    },
    "objective": {
      "type": "selector_losses",
      "loss_decay_gamma": 4.0,
      "base": {
        "type": "hard_ce",
        "weight": 0.1
      },
      "final": {
        "type": "weighted_sum",
        "components": [
          {
            "type": "hard_ce",
            "weight": 0.1
          },
          {
            "type": "l1",
            "weight": 0.9
          }
        ],
        "weight": 1.0
      }
    },
    "access_configs": {
      "dense": {},
      "sliding_window": {
        "window_size": 512
      }
    },
    "attention_configs": {
      "gqa": {
        "num_attention_heads": 16,
        "num_key_value_heads": 4,
        "head_dim": 256
      }
    }
  }
}
